# Copy to .env.local (never commit .env.local)
# PostgreSQL login role created by sql/07_roles.sql (db name and password are yours)
DATABASE_URL=postgresql://adtech_app:CHANGE_ME@localhost:5432/adtech
# Generate with:  openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_CHARS_OR_MORE
# MongoDB: raw ad events (Member 1's db and collection names)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=adtech_analytics
# API key that ad servers/trackers send in the x-api-key header to POST /api/events.
# Generate with:  openssl rand -hex 32     (if unset, event ingestion refuses all requests)
INGEST_API_KEY=CHANGE_ME_TO_A_RANDOM_KEY_OF_16_CHARS_OR_MORE
# Display currency for money amounts (display only): USD (default) or INR, ...
NEXT_PUBLIC_CURRENCY=USD
